<Window x:Class="SeedsClassification.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Classification des graines"
        Height="720" Width="1150"
        Background="#EEF1F5">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- MENU -->
        <Menu Grid.Row="0">
            <MenuItem Header="Expériences">
                <MenuItem Header="Voir historique" Click="OpenHistory"/>
            </MenuItem>
        </Menu>

        <!-- HEADER -->
        <Border Grid.Row="1"
                Background="#2C3E50"
                CornerRadius="12"
                Padding="15"
                Margin="0,10,0,10">

            <TextBlock Text="🌾 Classification des graines de blé"
                       Foreground="White"
                       FontSize="22"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- MAIN -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <!-- DATA -->
            <StackPanel Grid.Column="0" Margin="5">

                <TextBlock Text="Données d'entraînement"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <Border Background="White" CornerRadius="10" Padding="5">
                    <DataGrid ItemsSource="{Binding TrainData}" Height="260"/>
                </Border>

                <TextBlock Text="Données de test"
                           FontWeight="Bold"
                           Margin="0,15,0,5"/>

                <Border Background="White" CornerRadius="10" Padding="5">
                    <DataGrid ItemsSource="{Binding TestData}" Height="260"/>
                </Border>

            </StackPanel>

            <!-- PARAMETRES -->
            <StackPanel Grid.Column="1" Margin="10">

                <TextBlock Text="Paramètres"
                           FontSize="18"
                           FontWeight="Bold"/>

                <!-- LOAD CSV -->
                <Button Content="📂 Charger les données"
                        Command="{Binding LoadCommand}"
                        Background="#8E44AD"
                        Foreground="White"
                        Height="40"
                        Margin="0,10,0,10"
                        BorderThickness="0"/>

                <!-- 🔥 API USERS -->
                <Button Content="🌐 Charger utilisateurs"
                        Command="{Binding LoadUsersCommand}"
                        Background="#16A085"
                        Foreground="White"
                        Height="40"
                        Margin="0,10,0,5"
                        BorderThickness="0"/>

                <ComboBox ItemsSource="{Binding Users}"
                          SelectedItem="{Binding SelectedUser}"
                          DisplayMemberPath="FullName"
                          Height="30"
                          Margin="0,5"/>

                <!-- K -->
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="K :" Width="80"/>
                    <TextBox Width="60" Text="{Binding K}"/>
                </StackPanel>

                <!-- Distance -->
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Distance :" Width="80"/>
                    <ComboBox Width="130"
                              ItemsSource="{Binding Distances}"
                              SelectedItem="{Binding SelectedDistance}"/>
                </StackPanel>

                <!-- RUN -->
                <Button Content="🚀 Lancer KNN"
                        Command="{Binding RunCommand}"
                        Background="#3498DB"
                        Foreground="White"
                        Height="45"
                        Margin="0,20,0,10"
                        BorderThickness="0"/>

                <!-- Accuracy -->
                <Border Background="#27AE60"
                        CornerRadius="10"
                        Padding="12">

                    <TextBlock Text="{Binding Accuracy}"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </Border>

            </StackPanel>

            <!-- MATRICE -->
            <StackPanel Grid.Column="2" Margin="10">

                <TextBlock Text="Matrice de confusion"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10"
                           HorizontalAlignment="Center"/>

                <Border Background="White"
                        CornerRadius="12"
                        Padding="10">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"/>
                        <TextBlock Text="Kama" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center"/>
                        <TextBlock Text="Rosa" Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center"/>
                        <TextBlock Text="Canadian" Grid.Row="0" Grid.Column="3" HorizontalAlignment="Center"/>

                        <TextBlock Text="Kama" Grid.Row="1"/>
                        <TextBlock Text="{Binding CM00}" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CM01}" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CM02}" Grid.Row="1" Grid.Column="3" HorizontalAlignment="Center"/>

                        <TextBlock Text="Rosa" Grid.Row="2"/>
                        <TextBlock Text="{Binding CM10}" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CM11}" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CM12}" Grid.Row="2" Grid.Column="3" HorizontalAlignment="Center"/>

                        <TextBlock Text="Canadian" Grid.Row="3"/>
                        <TextBlock Text="{Binding CM20}" Grid.Row="3" Grid.Column="1" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CM21}" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CM22}" Grid.Row="3" Grid.Column="3" HorizontalAlignment="Center"/>

                    </Grid>

                </Border>

            </StackPanel>

        </Grid>

    </Grid>
</Window>