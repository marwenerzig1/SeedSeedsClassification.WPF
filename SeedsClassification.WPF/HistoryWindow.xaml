<Window x:Class="SeedsClassification.WPF.Views.HistoriqueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historique des expériences"
        Height="400" Width="700"
        Background="#EEF1F5">

    <Grid Margin="10">

        <DataGrid ItemsSource="{Binding Historique}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Utilisateur" Binding="{Binding Auteur}"/>
                <DataGridTextColumn Header="K" Binding="{Binding K}"/>
                <DataGridTextColumn Header="Distance" Binding="{Binding Distance}"/>
                <DataGridTextColumn Header="Accuracy"
                                     Binding="{Binding Accuracy, StringFormat={}{0:P2}}"/>
                <DataGridTextColumn Header="Date"
                                     Binding="{Binding DateExecution}"/>
            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</Window>